# Copy to .env for local development. Contains names and SAFE example values only.
# Never commit real secrets. The app validates these at startup and aborts if a
# required value is missing (see apps/api/src/config).

NODE_ENV=development
PORT=8080

# PostgreSQL connection string (real PostgreSQL; no in-memory fallback exists).
DATABASE_URL=postgres://postgres:postgres@localhost:5439/reasoning_tutor

# Better Auth. In production these MUST be provided by protected deployment config.
# Example secret below is a placeholder only; generate a real 32+ char secret.
BETTER_AUTH_SECRET=dev-only-example-secret-change-me-please-32
BETTER_AUTH_URL=http://localhost:8080

# Comma-separated list of trusted browser origins (CORS / CSRF).
# Include Capacitor WebView origins when packaging native apps.
TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8080,capacitor://localhost,http://localhost,ionic://localhost,https://localhost

# --- Browser vs native API configuration (separated) ---
# Browser builds: do NOT set VITE_API_BASE_URL (same-origin relative /api).
# Native Capacitor builds: REQUIRED. Production must be https://.
# Development/test native only may use http:// (e.g. Android emulator → host):
#   VITE_API_BASE_URL=http://10.0.2.2:8080
# Production native example:
#   VITE_API_BASE_URL=https://api.example.com

# Comma-separated reverse-proxy IP/CIDR list trusted to set X-Forwarded-For.
# Default empty (safe): Fastify trustProxy is false and Better Auth ignores
# X-Forwarded-For, so direct clients cannot spoof their IP for auth rate limits.
# Behind a known reverse proxy, set ONLY that proxy's addresses, for example:
#   TRUSTED_PROXIES=10.0.0.0/8
#   TRUSTED_PROXIES=192.168.1.10,10.0.0.0/8
# Never set a blank-trust-all value. Tests that need per-client X-Forwarded-For
# isolation set this explicitly (e.g. TRUSTED_PROXIES=127.0.0.1).
TRUSTED_PROXIES=

LOG_LEVEL=info
ENGINE_VERSION=1.0.0

# CONTENT_SEED_MODE controls the content import CLI: "off" | "import".
CONTENT_SEED_MODE=off

# AC-047: set to 1 only in explicit development/CI hosts without Xcode.
# This produces a documented SKIP, never a false PASS / release evidence.
# ALLOW_IOS_SMOKE_SKIP=1
# Force failure even if skip is set:
# VERIFY_REQUIRE_IOS=1
