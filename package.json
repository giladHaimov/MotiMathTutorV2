{
  "name": "reasoning-tutor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "workspaces": [
    "packages/contracts",
    "packages/engine",
    "packages/problem-content",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -b && tsc --noEmit -p apps/web/tsconfig.json",
    "build": "npm run build --workspace @app/web",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "npm run build --workspace @app/web && playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx db/migrate.ts",
    "db:seed": "tsx apps/api/src/modules/content/import-cli.ts",
    "auth:generate": "tsx apps/api/src/auth/generate-schema.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit",
    "verify": "bash scripts/verify.sh",
    "dev": "concurrently -n api,web -c blue,green \"npm:dev --workspace @app/api\" \"npm:dev --workspace @app/web\""
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^3.0.5",
    "concurrently": "^9.1.2",
    "drizzle-kit": "^0.31.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  }
}
