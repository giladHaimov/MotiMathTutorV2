<?xml version="1.0" encoding="utf-8"?>
<!-- Default (main): cleartext denied. Debug source set overrides for HTTP-dev. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
